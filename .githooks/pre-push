#!/bin/bash
# Pre-push hook for Lift project
# Runs comprehensive tests including race detection and full test suite

set -e

echo "Running pre-push checks..."

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Function to print colored output
print_status() {
    if [ $1 -eq 0 ]; then
        echo -e "${GREEN}✓ $2${NC}"
    else
        echo -e "${RED}✗ $2${NC}"
        exit 1
    fi
}

# Get the remote and branch being pushed to
remote="$1"
url="$2"

echo -e "${BLUE}Pushing to remote: $remote ($url)${NC}"

# 1. Ensure code compiles
echo -e "${YELLOW}Verifying code compilation...${NC}"
go build ./...
print_status $? "Code compilation"

# 2. Run go fmt check
echo -e "${YELLOW}Checking code formatting...${NC}"
UNFORMATTED=$(gofmt -l .)
if [ -n "$UNFORMATTED" ]; then
    echo -e "${RED}✗ Code formatting issues found. Please fix before pushing.${NC}"
    echo "$UNFORMATTED"
    exit 1
fi
print_status 0 "Code formatting"

# 3. Run go vet
echo -e "${YELLOW}Running go vet...${NC}"
go vet ./...
print_status $? "Go vet"

# 4. Run security scan with gosec (if available)
if command -v gosec &> /dev/null; then
    echo -e "${YELLOW}Running comprehensive security scan...${NC}"
    gosec -exclude-dir=vendor -tests=false -fmt=text ./...
    print_status $? "Security scan (gosec)"
fi

# 5. Run golangci-lint with stricter settings (if available)
if command -v golangci-lint &> /dev/null; then
    echo -e "${YELLOW}Running comprehensive lint checks...${NC}"
    golangci-lint run ./...
    print_status $? "Linting (golangci-lint)"
fi

# 6. Run tests with race detection
echo -e "${YELLOW}Running tests with race detection...${NC}"
go test -race -timeout 2m ./pkg/...
print_status $? "Tests with race detection"

# 7. Check test coverage (informational only, won't block push)
echo -e "${YELLOW}Checking test coverage...${NC}"
COVERAGE=$(go test -cover ./pkg/... 2>/dev/null | grep -E "coverage: [0-9]+\.[0-9]+%" | awk '{sum += $2; count++} END {if (count > 0) print sum/count; else print 0}')
if (( $(echo "$COVERAGE > 0" | bc -l) )); then
    echo -e "${BLUE}ℹ Average test coverage: ${COVERAGE}%${NC}"
fi

# 8. Validate CDK code if changes include CDK files
if git diff --cached --name-only | grep -q "pkg/cdk/"; then
    echo -e "${YELLOW}CDK changes detected, running CDK validation...${NC}"
    if command -v cdk &> /dev/null; then
        # Try to synthesize basic CDK app to validate constructs
        cd pkg/cdk/examples/basic-api 2>/dev/null && cdk synth --quiet && cd - >/dev/null
        print_status $? "CDK validation"
    else
        echo -e "${YELLOW}⚠ AWS CDK not found, skipping CDK validation${NC}"
    fi
fi

echo -e "${GREEN}All pre-push checks passed! Proceeding with push...${NC}"