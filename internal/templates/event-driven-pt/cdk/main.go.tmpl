package main

import (
	"fmt"
	"os"
	"path/filepath"

	"github.com/aws/aws-cdk-go/awscdk/v2"
	"github.com/aws/aws-cdk-go/awscdk/v2/awslambda"
	"github.com/aws/aws-cdk-go/awscdk/v2/awslambdaeventsources"
	"github.com/aws/aws-cdk-go/awscdk/v2/awssqs"
	"github.com/aws/jsii-runtime-go"
	liftcdk "github.com/pay-theory/lift/pkg/cdk/constructs"
)

func main() {
	defer jsii.Close()

	app := awscdk.NewApp(nil)

	stage := app.Node().TryGetContext(jsii.String("stage"))
	appName := app.Node().TryGetContext(jsii.String("appName"))
	partner := app.Node().TryGetContext(jsii.String("partner"))
	targetMode := app.Node().TryGetContext(jsii.String("targetMode"))

	// Bootstrap placeholder - allows cdk synth to succeed without context
	if stage == nil && appName == nil && partner == nil {
		awscdk.NewStack(app, jsii.String("CDKBootstrapPlaceholder"), &awscdk.StackProps{
			Env: env(),
		})
		app.Synth(nil)
		return
	}

	// Validate required parameters for PT mode
	if stage == nil {
		fmt.Println("Error: stage is required")
		fmt.Println("Usage: cdk deploy --context stage=<dev|staging|live> --context partner=<partner>")
		os.Exit(1)
	}
	if partner == nil {
		fmt.Println("Error: partner is required for PT mode deployments")
		fmt.Println("Usage: cdk deploy --context stage=<dev|staging|live> --context partner=<partner>")
		os.Exit(1)
	}

	// Set defaults
	stageStr := stage.(string)
	partnerStr := partner.(string)
	appNameStr := "{{ .AppName }}"
	if appName != nil {
		appNameStr = appName.(string)
	}
	targetModeStr := "standard"
	if targetMode != nil {
		targetModeStr = targetMode.(string)
	}

	// Log deployment context
	fmt.Printf("Deploying %s for partner=%s stage=%s targetMode=%s\n", appNameStr, partnerStr, stageStr, targetModeStr)

	// Create stack name with partner for multi-tenant isolation
	serviceStackName := fmt.Sprintf("%s-service-%s-%s", appNameStr, partnerStr, stageStr)

	// Create the service stack
	stack := awscdk.NewStack(app, jsii.String(serviceStackName), &awscdk.StackProps{
		Env:         env(),
		Description: jsii.String(fmt.Sprintf("%s event-driven service stack for partner %s, stage %s", appNameStr, partnerStr, stageStr)),
	})

	// Create Dead Letter Queue
	dlq := awssqs.NewQueue(stack, jsii.String("DeadLetterQueue"), &awssqs.QueueProps{
		QueueName:         jsii.String(fmt.Sprintf("%s-dlq-%s-%s", appNameStr, partnerStr, stageStr)),
		RetentionPeriod:   awscdk.Duration_Days(jsii.Number(14)),
		VisibilityTimeout: awscdk.Duration_Seconds(jsii.Number(300)),
	})

	// Create the main processing queue
	queue := awssqs.NewQueue(stack, jsii.String("ProcessingQueue"), &awssqs.QueueProps{
		QueueName:         jsii.String(fmt.Sprintf("%s-queue-%s-%s", appNameStr, partnerStr, stageStr)),
		VisibilityTimeout: awscdk.Duration_Seconds(jsii.Number(300)),
		DeadLetterQueue: &awssqs.DeadLetterQueue{
			Queue:           dlq,
			MaxReceiveCount: jsii.Number(3),
		},
	})

	// Create the API Lambda function
	apiFunction := liftcdk.NewLiftFunction(stack, jsii.String("ApiFunction"), &liftcdk.LiftFunctionProps{
		FunctionProps: awslambda.FunctionProps{
			FunctionName: jsii.String(fmt.Sprintf("%s-api-%s-%s", appNameStr, partnerStr, stageStr)),
			Code:         awslambda.Code_FromAsset(jsii.String(filepath.Join("..", "dist", "api")), nil),
			Handler:      jsii.String("bootstrap"),
			Description:  jsii.String(fmt.Sprintf("%s API handler for partner %s, stage %s", appNameStr, partnerStr, stageStr)),
			Environment: &map[string]*string{
				"QUEUE_URL":    queue.QueueUrl(),
				"PARTNER":      jsii.String(partnerStr),
				"STAGE":        jsii.String(stageStr),
				"TARGET_MODE":  jsii.String(targetModeStr),
			},
		},
		EnableTracing: jsii.Bool(true),
		EnableMetrics: jsii.Bool(true),
	})

	// Grant API function permission to send messages to the queue
	queue.GrantSendMessages(apiFunction.Function)

	// Create the Processor Lambda function
	processorFunction := liftcdk.NewLiftFunction(stack, jsii.String("ProcessorFunction"), &liftcdk.LiftFunctionProps{
		FunctionProps: awslambda.FunctionProps{
			FunctionName: jsii.String(fmt.Sprintf("%s-processor-%s-%s", appNameStr, partnerStr, stageStr)),
			Code:         awslambda.Code_FromAsset(jsii.String(filepath.Join("..", "dist", "processor")), nil),
			Handler:      jsii.String("bootstrap"),
			Description:  jsii.String(fmt.Sprintf("%s event processor for partner %s, stage %s", appNameStr, partnerStr, stageStr)),
			Environment: &map[string]*string{
				"QUEUE_URL":    queue.QueueUrl(),
				"PARTNER":      jsii.String(partnerStr),
				"STAGE":        jsii.String(stageStr),
				"TARGET_MODE":  jsii.String(targetModeStr),
			},
		},
		EnableTracing: jsii.Bool(true),
		EnableMetrics: jsii.Bool(true),
	})

	// Add SQS event source to processor
	processorFunction.Function.AddEventSource(awslambdaeventsources.NewSqsEventSource(queue, &awslambdaeventsources.SqsEventSourceProps{
		BatchSize: jsii.Number(10),
	}))

	// Outputs
	awscdk.NewCfnOutput(stack, jsii.String("ApiFunctionArn"), &awscdk.CfnOutputProps{
		Value:       apiFunction.Function.FunctionArn(),
		Description: jsii.String("API Lambda function ARN"),
		ExportName:  jsii.String(fmt.Sprintf("%s-%s-%s-ApiFunctionArn", appNameStr, partnerStr, stageStr)),
	})

	awscdk.NewCfnOutput(stack, jsii.String("ProcessorFunctionArn"), &awscdk.CfnOutputProps{
		Value:       processorFunction.Function.FunctionArn(),
		Description: jsii.String("Processor Lambda function ARN"),
		ExportName:  jsii.String(fmt.Sprintf("%s-%s-%s-ProcessorFunctionArn", appNameStr, partnerStr, stageStr)),
	})

	awscdk.NewCfnOutput(stack, jsii.String("QueueUrl"), &awscdk.CfnOutputProps{
		Value:       queue.QueueUrl(),
		Description: jsii.String("Processing queue URL"),
		ExportName:  jsii.String(fmt.Sprintf("%s-%s-%s-QueueUrl", appNameStr, partnerStr, stageStr)),
	})

	app.Synth(nil)
}

// env returns the AWS environment from environment variables
func env() *awscdk.Environment {
	return &awscdk.Environment{
		Account: jsii.String(os.Getenv("CDK_DEFAULT_ACCOUNT")),
		Region:  jsii.String(os.Getenv("CDK_DEFAULT_REGION")),
	}
}
