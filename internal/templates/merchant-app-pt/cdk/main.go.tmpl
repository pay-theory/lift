package main

import (
	"fmt"
	"os"
	"path/filepath"

	"github.com/aws/aws-cdk-go/awscdk/v2"
	"github.com/aws/aws-cdk-go/awscdk/v2/awsdynamodb"
	"github.com/aws/aws-cdk-go/awscdk/v2/awslambda"
	"github.com/aws/jsii-runtime-go"
	liftcdk "github.com/pay-theory/lift/pkg/cdk/constructs"
)

func main() {
	defer jsii.Close()

	app := awscdk.NewApp(nil)

	stage := app.Node().TryGetContext(jsii.String("stage"))
	appName := app.Node().TryGetContext(jsii.String("appName"))
	partner := app.Node().TryGetContext(jsii.String("partner"))
	targetMode := app.Node().TryGetContext(jsii.String("targetMode"))

	// Bootstrap placeholder - allows cdk synth to succeed without context
	if stage == nil && appName == nil && partner == nil {
		awscdk.NewStack(app, jsii.String("CDKBootstrapPlaceholder"), &awscdk.StackProps{
			Env: env(),
		})
		app.Synth(nil)
		return
	}

	// Validate required parameters for PT mode
	if stage == nil {
		fmt.Println("Error: stage is required")
		fmt.Println("Usage: cdk deploy --context stage=<dev|staging|live> --context partner=<partner>")
		os.Exit(1)
	}
	if partner == nil {
		fmt.Println("Error: partner is required for PT mode deployments")
		fmt.Println("Usage: cdk deploy --context stage=<dev|staging|live> --context partner=<partner>")
		os.Exit(1)
	}

	// Set defaults
	stageStr := stage.(string)
	partnerStr := partner.(string)
	appNameStr := "{{ .AppName }}"
	if appName != nil {
		appNameStr = appName.(string)
	}
	targetModeStr := "standard"
	if targetMode != nil {
		targetModeStr = targetMode.(string)
	}

	// Log deployment context
	fmt.Printf("Deploying %s for partner=%s stage=%s targetMode=%s\n", appNameStr, partnerStr, stageStr, targetModeStr)

	// Create stack names
	dataStackName := fmt.Sprintf("%s-data-%s-%s", appNameStr, partnerStr, stageStr)
	serviceStackName := fmt.Sprintf("%s-service-%s-%s", appNameStr, partnerStr, stageStr)

	// ============================================
	// DATA STACK
	// ============================================
	dataStack := awscdk.NewStack(app, jsii.String(dataStackName), &awscdk.StackProps{
		Env:         env(),
		Description: jsii.String(fmt.Sprintf("%s data stack for partner %s, stage %s", appNameStr, partnerStr, stageStr)),
	})

	// Create the main DynamoDB table (partner-scoped)
	table := awsdynamodb.NewTable(dataStack, jsii.String("MainTable"), &awsdynamodb.TableProps{
		TableName: jsii.String(fmt.Sprintf("%s-main-%s-%s", appNameStr, partnerStr, stageStr)),
		PartitionKey: &awsdynamodb.Attribute{
			Name: jsii.String("pk"),
			Type: awsdynamodb.AttributeType_STRING,
		},
		SortKey: &awsdynamodb.Attribute{
			Name: jsii.String("sk"),
			Type: awsdynamodb.AttributeType_STRING,
		},
		BillingMode:         awsdynamodb.BillingMode_PAY_PER_REQUEST,
		RemovalPolicy:       awscdk.RemovalPolicy_DESTROY,
		PointInTimeRecovery: jsii.Bool(true),
		TimeToLiveAttribute: jsii.String("ttl"),
	})

	// Export table name and ARN
	awscdk.NewCfnOutput(dataStack, jsii.String("TableName"), &awscdk.CfnOutputProps{
		Value:       table.TableName(),
		Description: jsii.String("Main DynamoDB table name"),
		ExportName:  jsii.String(fmt.Sprintf("%s-%s-%s-TableName", appNameStr, partnerStr, stageStr)),
	})

	awscdk.NewCfnOutput(dataStack, jsii.String("TableArn"), &awscdk.CfnOutputProps{
		Value:       table.TableArn(),
		Description: jsii.String("Main DynamoDB table ARN"),
		ExportName:  jsii.String(fmt.Sprintf("%s-%s-%s-TableArn", appNameStr, partnerStr, stageStr)),
	})

	// ============================================
	// SERVICE STACK
	// ============================================
	serviceStack := awscdk.NewStack(app, jsii.String(serviceStackName), &awscdk.StackProps{
		Env:         env(),
		Description: jsii.String(fmt.Sprintf("%s service stack for partner %s, stage %s", appNameStr, partnerStr, stageStr)),
	})

	// Add dependency: service stack depends on data stack
	serviceStack.AddDependency(dataStack, jsii.String("Data resources must exist before service"))

	// Create the API Lambda function
	apiFunction := liftcdk.NewLiftFunction(serviceStack, jsii.String("ApiFunction"), &liftcdk.LiftFunctionProps{
		FunctionProps: awslambda.FunctionProps{
			FunctionName: jsii.String(fmt.Sprintf("%s-api-%s-%s", appNameStr, partnerStr, stageStr)),
			Code:         awslambda.Code_FromAsset(jsii.String(filepath.Join("..", "dist", "api")), nil),
			Handler:      jsii.String("bootstrap"),
			Description:  jsii.String(fmt.Sprintf("%s API handler for partner %s, stage %s", appNameStr, partnerStr, stageStr)),
			Environment: &map[string]*string{
				"TABLE_NAME":   table.TableName(),
				"PARTNER":      jsii.String(partnerStr),
				"STAGE":        jsii.String(stageStr),
				"TARGET_MODE":  jsii.String(targetModeStr),
			},
		},
		EnableTracing: jsii.Bool(true),
		EnableMetrics: jsii.Bool(true),
	})

	// Create the Worker Lambda function
	workerFunction := liftcdk.NewLiftFunction(serviceStack, jsii.String("WorkerFunction"), &liftcdk.LiftFunctionProps{
		FunctionProps: awslambda.FunctionProps{
			FunctionName: jsii.String(fmt.Sprintf("%s-worker-%s-%s", appNameStr, partnerStr, stageStr)),
			Code:         awslambda.Code_FromAsset(jsii.String(filepath.Join("..", "dist", "worker")), nil),
			Handler:      jsii.String("bootstrap"),
			Description:  jsii.String(fmt.Sprintf("%s worker for partner %s, stage %s", appNameStr, partnerStr, stageStr)),
			Environment: &map[string]*string{
				"TABLE_NAME":   table.TableName(),
				"PARTNER":      jsii.String(partnerStr),
				"STAGE":        jsii.String(stageStr),
				"TARGET_MODE":  jsii.String(targetModeStr),
			},
		},
		EnableTracing: jsii.Bool(true),
		EnableMetrics: jsii.Bool(true),
	})

	// Grant access to the table
	table.GrantReadWriteData(apiFunction.Function)
	table.GrantReadWriteData(workerFunction.Function)

	// LIFT:ADD_FUNCTIONS

	// Outputs
	awscdk.NewCfnOutput(serviceStack, jsii.String("ApiFunctionArn"), &awscdk.CfnOutputProps{
		Value:       apiFunction.Function.FunctionArn(),
		Description: jsii.String("API Lambda function ARN"),
		ExportName:  jsii.String(fmt.Sprintf("%s-%s-%s-ApiFunctionArn", appNameStr, partnerStr, stageStr)),
	})

	awscdk.NewCfnOutput(serviceStack, jsii.String("WorkerFunctionArn"), &awscdk.CfnOutputProps{
		Value:       workerFunction.Function.FunctionArn(),
		Description: jsii.String("Worker Lambda function ARN"),
		ExportName:  jsii.String(fmt.Sprintf("%s-%s-%s-WorkerFunctionArn", appNameStr, partnerStr, stageStr)),
	})

	// LIFT:ADD_OUTPUTS

	app.Synth(nil)
}

// env returns the AWS environment from environment variables
func env() *awscdk.Environment {
	return &awscdk.Environment{
		Account: jsii.String(os.Getenv("CDK_DEFAULT_ACCOUNT")),
		Region:  jsii.String(os.Getenv("CDK_DEFAULT_REGION")),
	}
}
