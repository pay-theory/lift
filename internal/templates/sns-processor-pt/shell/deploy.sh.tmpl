#!/bin/bash

# {{.AppName}} CDK Deployment Script
# This script deploys the application infrastructure using AWS CDK

set -e  # Exit on any error

# Default values
PARTNER=""
STAGE=""
TARGET_MODE="standard"
REGION=""
ACCOUNT=""
COMMAND="deploy"
VERBOSE=""
BUILD_LAMBDAS="true"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Function to print colored output
print_status() {
    echo -e "${BLUE}[INFO]${NC} $1"
}

print_success() {
    echo -e "${GREEN}[SUCCESS]${NC} $1"
}

print_warning() {
    echo -e "${YELLOW}[WARNING]${NC} $1"
}

print_error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

# Function to show usage
usage() {
    cat << EOF
{{.AppName}} CDK Deployment Script

Usage: $0 [OPTIONS]

REQUIRED OPTIONS:
    -p, --partner PARTNER    Partner name (required)
    -s, --stage STAGE        Deployment stage: dev|staging|live (required)

OPTIONAL OPTIONS:
    -t, --target-mode MODE   Target mode (default: standard)
    -r, --region REGION      AWS region (auto-detected if not provided)
    -a, --account ACCOUNT    AWS account ID (auto-detected if not provided)
    -c, --command COMMAND    CDK command (deploy, destroy, diff, synth, bootstrap) [default: deploy]
    --no-build              Skip building Lambda functions
    -v, --verbose           Enable verbose output
    -h, --help              Show this help message

EXAMPLES:
    # Deploy for partner/dev
    $0 --partner mypartner --stage dev

    # Deploy without rebuilding Lambda functions
    $0 --partner mypartner --stage dev --no-build

    # Show diff for staging
    $0 --partner mypartner --stage staging --command diff

    # Destroy deployment
    $0 --partner mypartner --stage dev --command destroy

STAGES:
    dev        Development environment
    staging    Staging/QA environment
    live       Production environment

EOF
}

# Parse command line arguments
while [[ $# -gt 0 ]]; do
    case $1 in
        -p|--partner)
            PARTNER="$2"
            shift 2
            ;;
        -s|--stage)
            STAGE="$2"
            shift 2
            ;;
        -t|--target-mode)
            TARGET_MODE="$2"
            shift 2
            ;;
        -r|--region)
            REGION="$2"
            shift 2
            ;;
        -a|--account)
            ACCOUNT="$2"
            shift 2
            ;;
        -c|--command)
            COMMAND="$2"
            shift 2
            ;;
        --no-build)
            BUILD_LAMBDAS="false"
            shift
            ;;
        -v|--verbose)
            VERBOSE="--verbose"
            shift
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            print_error "Unknown option: $1"
            usage
            exit 1
            ;;
    esac
done

# Validate required parameters
if [[ -z "$PARTNER" ]]; then
    print_error "Partner is required. Use --partner to specify."
    usage
    exit 1
fi

if [[ -z "$STAGE" ]]; then
    print_error "Stage is required. Use --stage to specify."
    usage
    exit 1
fi

# Validate stage
if [[ ! "$STAGE" =~ ^(dev|staging|live)$ ]]; then
    print_error "Invalid stage: $STAGE. Must be dev, staging, or live."
    exit 1
fi

# Validate command
if [[ ! "$COMMAND" =~ ^(deploy|destroy|diff|synth|bootstrap)$ ]]; then
    print_error "Invalid command: $COMMAND. Must be deploy, destroy, diff, synth, or bootstrap."
    exit 1
fi

# Get AWS account ID if not provided
if [[ -z "$ACCOUNT" ]]; then
    print_status "Detecting AWS account ID..."
    ACCOUNT=$(aws sts get-caller-identity --query Account --output text 2>/dev/null || echo "")
    if [[ -z "$ACCOUNT" ]]; then
        print_error "Could not detect AWS account ID. Please provide it with --account or configure AWS credentials."
        exit 1
    fi
fi

# Get AWS region if not provided
if [[ -z "$REGION" ]]; then
    print_status "Detecting AWS region..."
    REGION=$(aws configure get region 2>/dev/null || echo "us-east-1")
fi

# Determine stack name
STACK_NAME="{{.AppName}}-service-${PARTNER}-${STAGE}"

print_status "Deployment Configuration:"
echo "  Partner: $PARTNER"
echo "  Stage: $STAGE"
echo "  Target Mode: $TARGET_MODE"
echo "  Region: $REGION"
echo "  Account: $ACCOUNT"
echo "  Command: $COMMAND"
echo "  Stack: $STACK_NAME"
echo "  Build Lambdas: $BUILD_LAMBDAS"

# Set environment variables for CDK
export CDK_DEFAULT_ACCOUNT="$ACCOUNT"
export CDK_DEFAULT_REGION="$REGION"

# Get script directory and project root
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"
CDK_DIR="$PROJECT_ROOT/cdk"

if [[ ! -d "$CDK_DIR" ]]; then
    print_error "CDK directory not found: $CDK_DIR"
    exit 1
fi

# Check if CDK is installed
if ! command -v cdk &> /dev/null; then
    print_error "AWS CDK CLI is not installed. Please install it with: npm install -g aws-cdk"
    exit 1
fi

# Check if Go is installed
if ! command -v go &> /dev/null; then
    print_error "Go is not installed. Please install Go 1.25 or later."
    exit 1
fi

# Build Lambda functions if deploying and not skipped
if [[ "$COMMAND" == "deploy" && "$BUILD_LAMBDAS" == "true" ]]; then
    print_status "Building Lambda functions..."
    "$SCRIPT_DIR/build.sh"
    print_success "Lambda functions built successfully"
fi

# Change to CDK directory
cd "$CDK_DIR"

# Install Go dependencies for CDK
print_status "Installing CDK Go dependencies..."
go mod tidy

print_status "Running CDK $COMMAND..."

case "$COMMAND" in
    deploy)
        cdk deploy "$STACK_NAME" --require-approval never \
            --context stage="$STAGE" \
            --context partner="$PARTNER" \
            --context targetMode="$TARGET_MODE" \
            $VERBOSE
        ;;
    destroy)
        print_warning "This will destroy all resources in stack: $STACK_NAME"
        read -p "Are you sure? (y/N): " confirm
        if [[ "$confirm" =~ ^[Yy]$ ]]; then
            cdk destroy "$STACK_NAME" --force \
                --context stage="$STAGE" \
                --context partner="$PARTNER" \
                --context targetMode="$TARGET_MODE" \
                $VERBOSE
        else
            print_status "Destroy cancelled"
            exit 0
        fi
        ;;
    diff)
        cdk diff "$STACK_NAME" \
            --context stage="$STAGE" \
            --context partner="$PARTNER" \
            --context targetMode="$TARGET_MODE" \
            $VERBOSE
        ;;
    synth)
        cdk synth "$STACK_NAME" \
            --context stage="$STAGE" \
            --context partner="$PARTNER" \
            --context targetMode="$TARGET_MODE" \
            $VERBOSE
        ;;
    bootstrap)
        cdk bootstrap \
            --context stage="$STAGE" \
            --context partner="$PARTNER" \
            --context targetMode="$TARGET_MODE" \
            $VERBOSE
        ;;
esac

print_success "CDK $COMMAND completed successfully!"
