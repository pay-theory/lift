#!/bin/bash

# Initialize environment variables for deployment

# REQUIRED: Set your partner name
export PARTNER="changeme"

# OPTIONAL: Default stage
export STAGE="dev"

# OPTIONAL: Target mode (default: standard)
export TARGET_MODE="standard"

echo "Environment variables set:"
echo "  PARTNER=$PARTNER"
echo "  STAGE=$STAGE"
echo "  TARGET_MODE=$TARGET_MODE"
