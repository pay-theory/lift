name: PR Check

on:
  pull_request:
    branches: [ main, master ]

jobs:
  test:
    runs-on: ubuntu-latest
    
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup Go
        uses: actions/setup-go@v5
        with:
          go-version: '1.25'

      - name: Run tests
        run: go test -mod=mod ./...

      - name: Build
        run: |
          mkdir -p dist/api dist/worker
          GOOS=linux GOARCH=arm64 CGO_ENABLED=0 go build -mod=mod -trimpath -ldflags="-s -w" -o dist/api/bootstrap ./cmd/api
          GOOS=linux GOARCH=arm64 CGO_ENABLED=0 go build -mod=mod -trimpath -ldflags="-s -w" -o dist/worker/bootstrap ./cmd/worker
